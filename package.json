{
  "name": "dsh-msgrail",
  "version": "1.0.0",
  "description": "消息轨道：对话右缘的消息索引（悬停预览、点击跳转、自动加载历史），纯插件零宿主侵入，皮肤全适配",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
